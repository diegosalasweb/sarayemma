---
export interface Props {
  ctaHref?: string;
  ctaText?: string;
}

const {
  ctaHref = '/colecciones/',
  ctaText = 'Explorar Colección',
} = Astro.props;
---

<section class="hero">
  <h1>Texturas y Diseños que <br /><em>Cuentan Historias</em></h1>
  <p>Una colección creada con dedicación, calma y respeto por lo esencial.</p>
  <a href={ctaHref} class="btn-editorial">{ctaText}</a>
</section>

<style>
  .hero {
    padding: 8rem 2rem 6rem;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 300;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    line-height: 1.15;
  }

  .hero h1 em {
    font-style: italic;
    font-weight: 400;
  }

  .hero p {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 1px;
    color: #666;
    max-width: 550px;
    margin: 0 auto 2.5rem;
  }

  .btn-editorial {
    display: inline-block;
    background-color: var(--color-primary);
    color: #fff;
    padding: 1.1rem 3rem;
    text-transform: uppercase;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 3px;
    font-weight: 500;
    border: 1px solid var(--color-primary);
    cursor: pointer;
    transition: var(--transition);
    text-decoration: none;
  }

  .btn-editorial:hover {
    background-color: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 5rem 1.5rem 4rem;
    }

    .hero h1 {
      font-size: 2.6rem;
    }
  }
</style>
