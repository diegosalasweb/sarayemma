<style>
  .footer {
    background: #F9F5F2;
    color: #555;
    font-family: 'Cormorant Garamond', Georgia, serif;
    padding: 3.5rem 2rem 0;
    border-top: 1px solid #e8e0d8;
  }

  /* ── 4 columnas ── */
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto 2.5rem;
  }

  .footer-col h4 {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #333;
    font-weight: 600;
    margin-bottom: 1.1rem;
  }

  /* Contacto con íconos */
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .contact-icon {
    flex-shrink: 0;
    margin-top: 2px;
    display: flex;
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .contact-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #888;
    text-transform: uppercase;
  }

  .contact-text a,
  .contact-text span {
    font-size: 0.9rem;
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.5;
  }

  .contact-text a:hover {
    color: #5b9bd5;
  }

  /* Links e info */
  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .link-list li,
  .link-list li a {
    font-size: 0.9rem;
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.6;
  }

  .link-list li a:hover {
    color: #5b9bd5;
  }

  /* Badge Webpay */
  .webpay-badge {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    background: #00529b;
    border-radius: 4px;
    padding: 0.3rem 0.75rem;
  }

  .webpay-text {
    font-family: Arial, sans-serif;
    font-size: 0.75rem;
    color: #fff;
    letter-spacing: 0.03em;
  }

  .webpay-text strong {
    color: #00aeef;
  }

  /* Datos bancarios */
  .bank-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bank-list li {
    font-size: 0.88rem;
    color: #555;
    line-height: 1.5;
  }

  .bank-list li strong {
    color: #333;
    font-weight: 600;
  }

  .bank-list li a {
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
  }

  .bank-list li a:hover {
    color: #5b9bd5;
  }

  /* ── Centro ── */
  .footer-center {
    text-align: center;
    padding: 1.5rem 0 0.5rem;
    border-top: 1px solid #e8e0d8;
  }

  .footer-center-logo {
    max-height: 180px;
    width: auto;
    margin: 0 auto;
  }

  /* ── Pie ── */
  .footer-bottom {
    border-top: 1px solid #e8e0d8;
    margin-top: 1rem;
    padding: 1.1rem 0;
    text-align: center;
    font-size: 0.78rem;
    color: #aaa;
    letter-spacing: 0.06em;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
    }
  }

  @media (max-width: 560px) {
    .footer-cols {
      grid-template-columns: 1fr;
    }

    .footer-brand-name {
      letter-spacing: 0.2em;
    }
  }
</style>
