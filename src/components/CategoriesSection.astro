---
const categories = [
  {
    name: 'Colecciones',
    img: '/images/categories/colecciones.jpg',
    href: '/colecciones/',
  },
  {
    name: 'Guagua',
    img: '/images/categories/guagua.jpg',
    href: '/guagua/',
  },
  {
    name: 'Infantil',
    img: '/images/categories/infantil.jpg',
    href: '/infantil/',
  },
  {
    name: 'Accesorios',
    img: '/images/categories/accesorios.jpg',
    href: '/accesorios/',
  },
];
---

<section class="categories-section">
  <div class="categories-grid">
    {categories.map((cat) => (
      <a href={cat.href} class="category-card">
        <div class="frame">
          <img src={cat.img} alt={cat.name} loading="lazy" decoding="async" />
        </div>
        <span class="category-name">{cat.name}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .categories-section {
    padding: 3rem 1.5rem;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .frame {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .category-card:hover .frame {
    transform: translateY(-5px);
  }

  .category-card:hover .frame img {
    transform: scale(1.04);
  }

  .category-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #d8d8d8;
  }

  /* Tablet: 2 columnas */
  @media (max-width: 900px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  /* Mobile: 2 columnas, imágenes sin recorte */
  @media (max-width: 480px) {
    .categories-section {
      padding: 2rem 0.75rem;
    }

    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      max-width: none;
    }

    .frame {
      aspect-ratio: auto;
    }

    .frame img {
      height: auto;
      object-fit: contain;
    }

    .category-name {
      font-size: 0.85rem;
    }
  }
</style>
