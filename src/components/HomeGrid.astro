---
const BASE = '/images/categories/';

const rows = [
  [
    { img: 'conejo-playa.png',        link: null },
    { img: 'oso-perro-globo.png',     link: null },
    { img: 'marco-colecciones-1.png', link: '/colecciones/' },
    { img: 'oso-flotador.png',        link: null },
    { img: 'raton-arena.png',         link: null },
  ],
  [
    { img: 'oso-familia.png',         link: null },
    { img: 'oso-cabritas.png',        link: null },
    { img: 'marco-guagua-1.png',      link: '/guagua/' },
    { img: 'puercospin-buzon.png',    link: null },
    { img: 'elefantes.png',           link: null },
  ],
  [
    { img: 'conejo-moto.png',         link: null },
    { img: 'oso-marinero.png',        link: null },
    { img: 'marco-infantil-1.png',    link: '/infantil/' },
    { img: 'patitos.png',             link: null },
    { img: 'conejo-globo.png',        link: null },
  ],
  [
    { img: 'oso-avion.png',           link: null },
    { img: 'puercospin-globo.png',    link: null },
    { img: 'marco-accesorios-2.png',  link: '/accesorios/' },
    { img: 'nutria-surf.png',         link: null },
    { img: 'oso-auto.png',            link: null },
  ],
  [
    { img: 'conejo-traje-bano.png',   link: null },
    { img: 'pulpo.png',               link: null },
    { img: 'marco-decoracion-1.png',  link: '/decoracion/' },
    { img: 'pollo-playa.png',         link: null },
    { img: 'delfin-playa.png',        link: null },
  ],
];
---

<div class="home-grid-section">
  {rows.map((row) => (
    <div class="grid-row">
      {row.map((cell, colIndex) => {
        const isCenter = colIndex === 2;
        return isCenter ? (
          <a href={cell.link!} class="cell cell--center">
            <div class="frame">
              <img src={BASE + cell.img} alt="" loading="lazy" decoding="async" />
            </div>
          </a>
        ) : (
          <div class="cell cell--side">
            <div class="frame">
              <img src={BASE + cell.img} alt="" loading="lazy" decoding="async" />
            </div>
          </div>
        );
      })}
    </div>
  ))}
</div>

<style>
  .home-grid-section {
    width: 100%;
    height: 100%;
    background-color: #b0becc;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Cada fila */
  .grid-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1.6fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
  }

  /* Celda base */
  .cell {
    display: block;
  }

  /* Marco */
  .frame {
    overflow: hidden;
  }

  /* Imágenes laterales: rectangulares 3:4 */
  .cell--side .frame {
    aspect-ratio: 3 / 4;
  }

  .cell--side .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Imagen central: más alta, prominente */
  .cell--center {
    text-decoration: none;
  }

  .cell--center .frame {
    aspect-ratio: 3 / 4;
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .cell--center .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .cell--center:hover .frame {
    transform: translateY(-4px) scale(1.02);
  }

  .cell--center:hover .frame img {
    transform: scale(1.04);
  }

  /* ── Mobile: 3 columnas ── */
  @media (max-width: 767px) {
    .home-grid-section {
      padding: 1rem 0.75rem;
      gap: 0.75rem;
    }

    .grid-row {
      grid-template-columns: 1fr 1.5fr 1fr;
      gap: 0.75rem;
    }

    /* Ocultar col 2 y col 4 (índices 1 y 3) */
    .cell:nth-child(2),
    .cell:nth-child(4) {
      display: none;
    }
  }
</style>
