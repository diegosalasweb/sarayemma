---
---

<section class="ig-banner">
  <div class="ig-inner">
    <!-- Ícono Instagram -->
    <div class="ig-icon" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
      </svg>
    </div>

    <p class="ig-subtitle">Descubre nuestras últimas creaciones</p>
    <h2 class="ig-title">Síguenos en Instagram</h2>

    <a
      href="https://www.instagram.com/sara_y_emma/"
      target="_blank"
      rel="noopener noreferrer"
      class="ig-btn"
    >
      Seguir @sara_y_emma
    </a>
  </div>
</section>

<style>
  .ig-banner {
    background-color: #e8dfd6;
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .ig-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 560px;
    margin: 0 auto;
  }

  .ig-icon {
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .ig-subtitle {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent);
  }

  .ig-title {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .ig-btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.8rem 2.2rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-white);
    background-color: var(--color-accent);
    border: 1px solid var(--color-accent);
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .ig-btn:hover {
    background-color: transparent;
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .ig-banner {
      padding: 3.5rem 1rem;
    }

    .ig-title {
      font-size: 1.75rem;
    }

    .ig-icon svg {
      width: 32px;
      height: 32px;
    }
  }
</style>
